# Copy this file to .env and fill in LOCALSTACK_AUTH_TOKEN.
# .env is git-ignored: never commit it. Bun loads it automatically for host processes
# (bun run dev, tests), and docker compose reads it for variable substitution.

# --- LocalStack (required) ---
# Personal auth token from the LocalStack web app (app.localstack.cloud > Auth Tokens).
# The free Hobby plan is enough.
LOCALSTACK_AUTH_TOKEN=

# --- Host ports published by docker compose ---
# Change them if they clash with services already running on your machine. PostgreSQL is
# published on 55432, not 5432, so a locally installed PostgreSQL does not answer instead.
# If you change POSTGRES_PORT or LOCALSTACK_PORT, update the URLs below to match.
APP_PORT=3000
POSTGRES_PORT=55432
LOCALSTACK_PORT=4566

# --- Settings for processes started on the host (bun run dev, migrations, tests) ---
# Containers started by docker compose get their own values from compose.yaml.
DATABASE_URL=postgresql://wagering:wagering@localhost:55432/wagering
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack accepts any credentials; these are placeholders, not secrets.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOG_LEVEL=info
