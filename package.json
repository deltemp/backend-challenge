{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test --preload ./test/support/preload.ts --timeout 60000 ./test/integration",
    "test:concurrency": "bun test --preload ./test/support/preload.ts --timeout 120000 ./test/concurrency",
    "test:load": "bun scripts/load-test.ts",
    "migration:create": "bun scripts/migrations.ts create",
    "migration:up": "bun scripts/migrations.ts up",
    "migration:down": "bun scripts/migrations.ts down",
    "provision": "bun scripts/provision.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1175.0",
    "@mikro-orm/core": "7.2.11",
    "@mikro-orm/migrations": "7.2.11",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.11",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/terminus": "12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "decimal.js": "10.6.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "@types/express": "5.0.6",
    "typescript": "7.0.2"
  }
}
