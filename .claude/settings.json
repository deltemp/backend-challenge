{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(docker info)",
      "Bash(docker ps *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose build *)",
      "Bash(docker compose start *)",
      "Bash(docker compose stop *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose kill *)",
      "Bash(docker compose down)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(bun install)",
      "PowerShell(bun install --frozen-lockfile)",
      "PowerShell(bun run *)",
      "PowerShell(bun test *)",
      "PowerShell(docker info)",
      "PowerShell(docker ps *)",
      "PowerShell(docker compose up *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose logs *)",
      "PowerShell(docker compose build *)",
      "PowerShell(docker compose start *)",
      "PowerShell(docker compose stop *)",
      "PowerShell(docker compose restart *)",
      "PowerShell(docker compose kill *)",
      "PowerShell(docker compose down)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker inspect *)",
      "PowerShell(git push *)",
      "PowerShell(docker inspect *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(docker compose config *)",
      "PowerShell(docker compose config *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" format-on-edit",
            "timeout": 30,
            "statusMessage": "Formatting with Biome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" typecheck-on-stop",
            "timeout": 180,
            "statusMessage": "Typechecking"
          }
        ]
      }
    ]
  }
}
